<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Jove.ClimbLadder</AssemblyName>
    <RootNamespace>Jove.ClimbLadder</RootNamespace>
    <Version>0.1.2</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <TimberbornManaged Condition="'$(TimberbornManaged)' == ''">$(HOME)/Library/Application Support/Steam/steamapps/common/Timberborn/Timberborn.app/Contents/Resources/Data/Managed</TimberbornManaged>
    <ModInstallDir Condition="'$(ModInstallDir)' == ''">$(HOME)/Documents/Timberborn/Mods/ClimbLadder</ModInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Timberborn.BaseComponentSystem"><HintPath>$(TimberbornManaged)/Timberborn.BaseComponentSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Timberborn.EntitySystem"><HintPath>$(TimberbornManaged)/Timberborn.EntitySystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Timberborn.BlockSystem"><HintPath>$(TimberbornManaged)/Timberborn.BlockSystem.dll</HintPath><Private>false</Private></Reference>
