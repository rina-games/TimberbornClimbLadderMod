    <Reference Include="Timberborn.PathSystem"><HintPath>$(TimberbornManaged)/Timberborn.PathSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Timberborn.TemplateInstantiation"><HintPath>$(TimberbornManaged)/Timberborn.TemplateInstantiation.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Timberborn.Common"><HintPath>$(TimberbornManaged)/Timberborn.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Timberborn.SingletonSystem"><HintPath>$(TimberbornManaged)/Timberborn.SingletonSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Timberborn.TemplateSystem"><HintPath>$(TimberbornManaged)/Timberborn.TemplateSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Timberborn.Timbermesh"><HintPath>$(TimberbornManaged)/Timberborn.Timbermesh.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Timberborn.BlockObjectTools"><HintPath>$(TimberbornManaged)/Timberborn.BlockObjectTools.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Timberborn.ToolSystem"><HintPath>$(TimberbornManaged)/Timberborn.ToolSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Timberborn.ToolButtonSystem"><HintPath>$(TimberbornManaged)/Timberborn.ToolButtonSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Timberborn.ToolSystemUI"><HintPath>$(TimberbornManaged)/Timberborn.ToolSystemUI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Timberborn.InputSystem"><HintPath>$(TimberbornManaged)/Timberborn.InputSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Timberborn.Buildings"><HintPath>$(TimberbornManaged)/Timberborn.Buildings.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Timberborn.ConstructionSites"><HintPath>$(TimberbornManaged)/Timberborn.ConstructionSites.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Timberborn.Coordinates"><HintPath>$(TimberbornManaged)/Timberborn.Coordinates.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Timberborn.GridTraversing"><HintPath>$(TimberbornManaged)/Timberborn.GridTraversing.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Timberborn.CameraSystem"><HintPath>$(TimberbornManaged)/Timberborn.CameraSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Timberborn.TerrainSystem"><HintPath>$(TimberbornManaged)/Timberborn.TerrainSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Timberborn.Demolishing"><HintPath>$(TimberbornManaged)/Timberborn.Demolishing.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Timberborn.WorldPersistence"><HintPath>$(TimberbornManaged)/Timberborn.WorldPersistence.dll</HintPath><Private>false</Private></Reference>
