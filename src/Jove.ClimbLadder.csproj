    <Reference Include="Timberborn.AssetSystem"><HintPath>$(TimberbornManaged)/Timberborn.AssetSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Timberborn.ScienceSystem"><HintPath>$(TimberbornManaged)/Timberborn.ScienceSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Timberborn.CoreUI"><HintPath>$(TimberbornManaged)/Timberborn.CoreUI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Timberborn.UndoSystem"><HintPath>$(TimberbornManaged)/Timberborn.UndoSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Timberborn.GameFactionSystem"><HintPath>$(TimberbornManaged)/Timberborn.GameFactionSystem.dll</HintPath><Private>false</Private></Reference>
