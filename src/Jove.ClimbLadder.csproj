  </ItemGroup>

  <Target Name="DeployToGameMod" AfterTargets="Build">
    <MakeDir Directories="$(ModInstallDir)/Scripts" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModInstallDir)/Scripts" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildProjectDirectory)/../Scripts" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../manifest.json" DestinationFolder="$(ModInstallDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../thumbnail.png" DestinationFolder="$(ModInstallDir)" Condition="Exists('$(MSBuildProjectDirectory)/../thumbnail.png')" />
  </Target>

</Project>
